{
  "name": "nightscout",
  "version": "15.2.0",
  "description": "Nightscout acts as a web-based CGM (Continuous Glucose Montinor) to allow multiple caregivers to remotely view a patients glucose data in realtime.",
  "license": "AGPL-3.0",
  "author": "Nightscout Team",
  "homepage": "http://nightscout.github.io/",
  "keywords": [
    "diabetes",
    "continuous glucose management",
    "cgm in the cloud",
    "cgm",
    "dexcom"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/nightscout/cgm-remote-monitor.git"
  },
  "contributors": [
    {
      "name": "Nightscout Team",
      "url": "https://github.com/nightscout/cgm-remote-monitor/graphs/contributors"
    }
  ],
  "bugs": {
    "url": "https://github.com/nightscout/cgm-remote-monitor/issues"
  },
  "scripts": {
    "start": "bun lib/server/server.js",
    "env": "env",
    "postinstall": "mkdir -p node_modules/.cache/_ns_cache/public && webpack --mode production --config webpack/webpack.config.js && bun run post-generate-keys",
    "bundle": "webpack --mode production --config webpack/webpack.config.js && bun run post-generate-keys",
    "bundle-dev": "webpack --mode development --config webpack/webpack.config.js && bun run post-generate-keys",
    "post-generate-keys": "mkdir -p node_modules/.cache/_ns_cache && bun bin/generateRandomString.js >node_modules/.cache/_ns_cache/randomString && bun bin/generateGitCommit.js",
    "dev": "bun --env-file=./my.env --watch lib/server/server.js 0.0.0.0",
    "dev-test": "bun --env-file=./my.devtest.env --watch lib/server/server.js 0.0.0.0",
    "prod": "bun --env-file=./my.prod.env lib/server/server.js 0.0.0.0"
  },
  "main": "lib/server/server.js",
  "engines": {
    "bun": "^1.x"
  },
  "dependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@parse/node-apn": "^7.1.0",
    "acorn": "8.17.0",
    "acorn-jsx": "^5.3.1",
    "async": "^0.9.2",
    "axios": "^1.18.0",
    "babel-loader": "^10.1.1",
    "body-parser": "^1.19.0",
    "bootevent": "0.0.1",
    "braces": "3.0.3",
    "buffer": "^6.0.3",
    "compression": "1.8.1",
    "crypto-browserify": "^3.12.0",
    "css-loader": "^7.1.4",
    "cssmin": "^0.4.3",
    "csv-stringify": "^6.8.0",
    "d3": "^7.9.0",
    "dompurify": "3.4.10",
    "easyxml": "^2.0.1",
    "ejs": "^3.1.8",
    "errorhandler": "1.5.2",
    "event-stream": "3.3.4",
    "expose-loader": "^5.0.1",
    "express": "4.22.1",
    "express-minify": "^1.0.0",
    "fast-password-entropy": "^1.1.1",
    "file-loader": "^6.2.0",
    "flot": "^0.8.3",
    "forwarded-for": "^1.1.0",
    "helmet": "^8.2.0",
    "jquery": "^3.5.1",
    "jquery-ui-bundle": "^1.12.1-migrate",
    "jquery.tooltips": "^1.0.0",
    "js-storage": "^1.1.0",
    "jsdom": "^28.1.0",
    "jsonwebtoken": "9.0.3",
    "lodash": "^4.18.1",
    "memory-cache": "^0.2.0",
    "mime": "^2.4.6",
    "moment": "2.30.1",
    "moment-locales-webpack-plugin": "^1.2.0",
    "moment-timezone": "^0.6.2",
    "moment-timezone-data-webpack-plugin": "^1.5.0",
    "mongo-url-parser": "^1.0.2",
    "mongodb": "^4.17.2",
    "mongomock": "^0.1.2",
    "nightscout-connect": "github:psonnera/nightscout-connect#bun",
    "node-cache": "^5.1.2",
    "parse-duration": "2.1.6",
    "process": "^0.11.10",
    "pushover-notifications": "1.2.3",
    "random-token": "0.0.8",
    "semver": "^7.8.4",
    "shiro-trie": "^0.4.9",
    "simple-statistics": "^7.9.0",
    "socket.io": "4.8.3",
    "socket.io-client": "4.8.3",
    "stream-browserify": "^3.0.0",
    "style-loader": "^4.0.0",
    "swagger-ui-dist": "^5.32.6",
    "swagger-ui-express": "^5.0.1",
    "traverse": "0.6.11",
    "uuid": "^13.0.2",
    "vm-browserify": "^1.1.2",
    "webpack": "5.107.2",
    "webpack-cli": "^4.10.0"
  },
  "overrides": {
    "ws": "^8.20.1",
    "qs": "^6.15.2",
    "fast-xml-parser": "^5.7.0",
    "node-forge": "^1.4.0",
    "undici": "^7.24.0",
    "postcss": "^8.5.10",
    "fast-uri": "^3.1.2",
    "minimatch": "^10.2.3",
    "brace-expansion": "^5.0.6",
    "ip-address": "^10.1.1",
    "path-to-regexp": "0.1.13"
  }
}
